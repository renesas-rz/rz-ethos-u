From 99a28ffe9f0d49c076e323db92a3f272cbbf86a7 Mon Sep 17 00:00:00 2001
From: Ayman Chaudhry <ayman.chaudhry.kc@renesas.com>
Date: Thu, 22 Oct 2026 15:48:52 +0100
Subject: [PATCH] ethosu: regor: cmake: cpack_config.cmake: Support
 cross-compiling for other systems

Allow cross-compiling Ethos-U Vela for platforms other than the i386.

Upstream-Status: Pending
Signed-off-by: Ayman Chaudhry <ayman.chaudhry.kc@renesas.com>
---
 ethosu/regor/cmake/cpack_config.cmake | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/ethosu/regor/cmake/cpack_config.cmake b/ethosu/regor/cmake/cpack_config.cmake
index 24042e1f..aa573ece 100644
--- a/ethosu/regor/cmake/cpack_config.cmake
+++ b/ethosu/regor/cmake/cpack_config.cmake
@@ -29,6 +29,8 @@ include(InstallRequiredSystemLibraries)
 if (CMAKE_CROSSCOMPILING)
     if (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR STREQUAL "i386")
         set(REGOR_SYSTEM_NAME "linux-i586")
+    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+        set(REGOR_SYSTEM_NAME "linux-${CMAKE_SYSTEM_PROCESSOR}")
     else()
         message(FATAL_ERROR "Unknown cross-compile system")
     endif()
-- 
2.34.1

