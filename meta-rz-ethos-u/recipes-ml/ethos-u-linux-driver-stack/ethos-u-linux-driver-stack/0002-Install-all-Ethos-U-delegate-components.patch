From 36e917b7be42b0debc9da0a30228679ee114e593 Mon Sep 17 00:00:00 2001
From: Ayman Chaudhry <ayman.chaudhry.kc@renesas.com>
Date: Thu, 24 Sep 2026 07:47:39 +0000
Subject: [PATCH] Install all Ethos-U delegate components

Currently there are Ethos-U delegate components that are built by the
Driver Stack, but not installed. These components are:
- Ethos-U delegate
- TensorFlow Lite and XNNPack libraries
- C++ Delegate Runner application

Lets update their respective CMakeLists.txt's to install them.

Upstream-Status: Inappropriate [enable feature]
Signed-off-by: Ayman Chaudhry <ayman.chaudhry.kc@renesas.com>
---
 delegate/CMakeLists.txt              |  5 +++++
 thirdparty/CMakeLists.txt            | 10 ++++++++++
 utils/delegate_runner/CMakeLists.txt |  3 +++
 3 files changed, 18 insertions(+)

diff --git a/delegate/CMakeLists.txt b/delegate/CMakeLists.txt
index 9902600..f4da746 100644
--- a/delegate/CMakeLists.txt
+++ b/delegate/CMakeLists.txt
@@ -33,3 +33,8 @@ target_link_libraries(ethosu_op_delegate tensorflow-lite ethosu)
 if(DRIVER_BACKEND STREQUAL "drm")
     target_compile_definitions(ethosu_op_delegate PRIVATE ETHOSU_DRIVER_BACKEND_DRM=1)
 endif()
+
+# Install Ethos-U delegate
+install(TARGETS ethosu_op_delegate
+        LIBRARY DESTINATION "lib"
+        ARCHIVE DESTINATION "lib")
diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f0ba951..bd765dc 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -45,4 +45,14 @@ if(BUILD_DELEGATE)
     set_target_properties(tensorflow-lite PROPERTIES
         INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
         $<TARGET_PROPERTY:tensorflow-lite,INTERFACE_INCLUDE_DIRECTORIES>)
+
+    # Install TensorFlow and XNNPack libraries
+    install(TARGETS tensorflow-lite
+        LIBRARY DESTINATION "lib"
+        ARCHIVE DESTINATION "lib")
+    if(TARGET xnnpack-delegate)
+        install(TARGETS xnnpack-delegate
+            LIBRARY DESTINATION "lib"
+            ARCHIVE DESTINATION "lib")
+    endif()
 endif()
diff --git a/utils/delegate_runner/CMakeLists.txt b/utils/delegate_runner/CMakeLists.txt
index e0878a0..6f374a9 100644
--- a/utils/delegate_runner/CMakeLists.txt
+++ b/utils/delegate_runner/CMakeLists.txt
@@ -36,3 +36,6 @@ target_link_libraries(delegate_runner tensorflow-lite ethosu)
 if(DRIVER_BACKEND STREQUAL "drm")
     target_compile_definitions(delegate_runner PRIVATE ETHOSU_DRIVER_BACKEND_DRM=1)
 endif()
+
+# Install delegate_runner application
+install(TARGETS delegate_runner DESTINATION "bin")
-- 
2.34.1

