From 6a750d03e6309c3b3012582d2dd76a251f25c46b Mon Sep 17 00:00:00 2001
From: Ayman Chaudhry <ayman.chaudhry.kc@renesas.com>
Date: Thu, 27 Aug 2026 15:28:07 +0000
Subject: [PATCH] clk: renesas: r9a09g047-cpg: Add NPU clocks and resets

Add NPU clock and reset entries to CPG driver.

Upstream-Status: Pending
Signed-off-by: Ayman Chaudhry <ayman.chaudhry.kc@renesas.com>
---
 drivers/clk/renesas/r9a09g047-cpg.c | 21 +++++++++++++++++++++
 drivers/clk/renesas/rzv2h-cpg.h     |  4 ++++
 2 files changed, 25 insertions(+)

diff --git a/drivers/clk/renesas/r9a09g047-cpg.c b/drivers/clk/renesas/r9a09g047-cpg.c
index 6d15d78757bb..d7e38336eee1 100644
--- a/drivers/clk/renesas/r9a09g047-cpg.c
+++ b/drivers/clk/renesas/r9a09g047-cpg.c
@@ -69,6 +69,8 @@ enum clk_ids {
 	CLK_PLLDTY_DIV8,
 	CLK_PLLDTY_RCPU,
 	CLK_PLLDTY_RCPU_DIV4,
+	CLK_PLLDTY_NPU,
+	CLK_PLLDTY_NPU_DIV2,
 	CLK_PLLETH_DIV_250_FIX,
 	CLK_PLLETH_DIV_125_FIX,
 	CLK_CSDIV_PLLETH_GBE0,
@@ -77,6 +79,7 @@ enum clk_ids {
 	CLK_SMUX2_GBE0_RXCLK,
 	CLK_SMUX2_GBE1_TXCLK,
 	CLK_SMUX2_GBE1_RXCLK,
+	CLK_PLLETH_NPU,
 	CLK_SMUX2_DSI0_CLK,
 	CLK_SMUX2_DSI1_CLK,
 	CLK_PLLDTY_DIV16,
@@ -94,6 +97,12 @@ enum clk_ids {
 	MOD_CLK_BASE,
 };
 
+static const struct clk_div_table dtable_1_4[] = {
+	{0, 1},
+	{1, 2},
+	{2, 4},
+};
+
 static const struct clk_div_table dtable_1_8[] = {
 	{0, 1},
 	{1, 2},
@@ -246,6 +255,8 @@ static const struct cpg_core_clk r9a09g047_core_clks[]  = {
 	DEF_FIXED(".plldty_div16", CLK_PLLDTY_DIV16, CLK_PLLDTY, 1, 16),
 	DEF_DDIV(".plldty_rcpu", CLK_PLLDTY_RCPU, CLK_PLLDTY, CDDIV3_DIVCTL2, dtable_2_64),
 	DEF_FIXED(".plldty_rcpu_div4", CLK_PLLDTY_RCPU_DIV4, CLK_PLLDTY_RCPU, 1, 4),
+	DEF_DDIV(".plldty_npu", CLK_PLLDTY_NPU, CLK_PLLDTY, CDDIV5_DIVCTL0, dtable_2_64),
+	DEF_FIXED(".plldty_npu_div2", CLK_PLLDTY_NPU_DIV2, CLK_PLLDTY_NPU, 1, 2),
 
 	DEF_DDIV(".pllvdo_cru0", CLK_PLLVDO_CRU0, CLK_PLLVDO, CDDIV3_DIVCTL3, dtable_2_4),
 	DEF_DDIV(".pllvdo_gpu", CLK_PLLVDO_GPU, CLK_PLLVDO, CDDIV3_DIVCTL1, dtable_2_64),
@@ -253,6 +264,7 @@ static const struct cpg_core_clk r9a09g047_core_clks[]  = {
 	DEF_FIXED(".plleth_div4_lpclk", CLK_PLLETH_DIV4_LPCLK, CLK_PLLETH, 1, 4),
 	DEF_CSDIV(".plleth_lpclk", CLK_PLLETH_LPCLK, CLK_PLLETH_DIV4_LPCLK,
 		  CSDIV0_DIVCTL2, dtable_16_128),
+	DEF_DDIV(".plleth_npu", CLK_PLLETH_NPU, CLK_PLLETH, CDDIV4_DIVCTL3, dtable_1_4),
 
 	DEF_PLLDSI_DIV(".plldsi0_csdiv", CLK_PLLDSI0_CSDIV, CLK_PLLDSI0,
 		       CSDIV1_DIVCTL2, dtable_2_16_plldsi),
@@ -767,6 +779,12 @@ static const struct rzv2h_mod_clk r9a09g047_mod_clks[] = {
 						BUS_MSTOP(13, BIT(5) | BIT(4) | BIT(3))),
 	DEF_MOD("lcdc_1_clk_d",			CLK_SMUX2_DSI1_CLK, 26, 10, 11, 0,
 						BUS_MSTOP(13, BIT(5) | BIT(4) | BIT(3))),
+	DEF_MOD("npu_aclk",			CLK_PLLDTY_NPU_DIV2, 26, 11, 11, 1,
+						BUS_MSTOP(13, BIT(6))),
+	DEF_MOD("npu_pclk",			CLK_PLLDTY_NPU_DIV2, 26, 12, 11, 2,
+						BUS_MSTOP(13, BIT(6))),
+	DEF_MOD("npu_mclk",			CLK_PLLETH_NPU, 26, 13, 11, 3,
+						BUS_MSTOP(13, BIT(6))),
 	DEF_MOD("fdp1_clk_m",			CLK_PLLDTY_DIV2, 27, 1, 11, 7,
 						BUS_MSTOP(13, BIT(10) | BIT(9))),
 	DEF_MOD("fdp1_clk_a",			CLK_PLLDTY_DIV4, 27, 2, 11, 8,
@@ -908,6 +926,9 @@ static const struct rzv2h_reset r9a09g047_resets[] = {
 	DEF_RST(17, 12, 8, 13),		/* VSPI_SRESET_VSP1Z */
 	DEF_RST(17, 13, 8, 14),		/* VSPI_SPRESET_FCPVI0 */
 	DEF_RST(17, 14, 8, 15),		/* LCDC_1_RESET_N */
+	DEF_RST(18, 0, 9, 0),		/* NPU_nRESET */
+	DEF_RST(18, 1, 9, 1),		/* NPU_nARESET */
+	DEF_RST(18, 2, 9, 2),		/* NPU_nPRESET */
 	DEF_RST(18, 4, 9, 4),		/* FDP1_BRDG_RESETN */
 	DEF_RST(18, 5, 9, 5),		/* FDP1_FDP1_RESETN */
 	DEF_RST(18, 6, 9, 6),		/* FDP1_FCPF1_RESETP */
diff --git a/drivers/clk/renesas/rzv2h-cpg.h b/drivers/clk/renesas/rzv2h-cpg.h
index 3f47321c85d1..a92897c71190 100644
--- a/drivers/clk/renesas/rzv2h-cpg.h
+++ b/drivers/clk/renesas/rzv2h-cpg.h
@@ -128,6 +128,7 @@ struct fixed_mod_conf {
 #define CPG_CDDIV2		(0x408)
 #define CPG_CDDIV3		(0x40C)
 #define CPG_CDDIV4		(0x410)
+#define CPG_CDDIV5		(0x414)
 #define CPG_CSDIV0		(0x500)
 #define CPG_CSDIV1		(0x504)
 
@@ -147,6 +148,9 @@ struct fixed_mod_conf {
 #define CDDIV4_DIVCTL0	DDIV_PACK(CPG_CDDIV4, 0, 1, 16)
 #define CDDIV4_DIVCTL1	DDIV_PACK(CPG_CDDIV4, 4, 1, 17)
 #define CDDIV4_DIVCTL2	DDIV_PACK(CPG_CDDIV4, 8, 1, 18)
+/* RZ/G3E only */
+#define CDDIV4_DIVCTL3	DDIV_PACK(CPG_CDDIV4, 12, 2, 19)
+#define CDDIV5_DIVCTL0	DDIV_PACK(CPG_CDDIV5, 0, 3, 20)
 
 
 #define CSDIV0_DIVCTL0	DDIV_PACK(CPG_CSDIV0, 0, 2, CSDIV_NO_MON)
-- 
2.34.1

